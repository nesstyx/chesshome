[Unit]
Description=ChessHome Go service
After=network.target

[Service]
Type=simple
# Укажи пользователя с минимальными правами и путь к проекту
User=chesshome
WorkingDirectory=/opt/chesshome-go
ExecStart=/opt/chesshome-go/chesshome-go
NoNewPrivileges=true
Restart=on-failure
Environment=GO_PORT=8081

[Install]
WantedBy=multi-user.target
